 	var img := Image.create(20, 20, false, Image.FORMAT_RGBA8)
 	img.fill(Color(0, 0, 0, 0))
 	for y in range(20):
 		for x in range(20):
 			if absf(x - 4) + absf(y - 4) <= 5:
 				img.set_pixel(x, y, Color(1, 1, 1, 1))
-	return ImageTexture.create_from_image(img)
+	return img
