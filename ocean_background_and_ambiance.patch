diff --git a/shaders/ocean_waves_background.gdshader b/shaders/ocean_waves_background.gdshader
new file mode 100644
index 0000000..92e6dd2
--- /dev/null
+++ b/shaders/ocean_waves_background.gdshader
@@ -0,0 +1,63 @@
+shader_type canvas_item;
+
+// Fond animé pour l'écran de jeu (board.tscn) : de nombreuses sinusoïdes
+// remplies (zone sous la courbe colorée, pas juste un trait) empilées du
+// haut vers le bas de l'écran et mélangées entre elles par transparence,
+// pour un effet de vagues superposées. Chaque courbe a sa propre
+// fréquence, sa propre vitesse (alternée gauche/droite) et sa propre
+// teinte.
+
+uniform vec4 background_color : source_color = vec4(0.01, 0.03, 0.10, 1.0);
+uniform float speed : hint_range(0.0, 2.0) = 0.35;
+uniform float amplitude : hint_range(0.0, 0.3) = 0.06;
+uniform float base_hue : hint_range(0.0, 1.0) = 0.55;
+uniform float layer_alpha : hint_range(0.0, 1.0) = 0.35;
+
+const int WAVE_COUNT = 14;
+
+vec3 hsv2rgb(vec3 c) {
+	vec4 k = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
+	vec3 p = abs(fract(c.xxx + k.xyz) * 6.0 - k.www);
+	return c.z * mix(k.xxx, clamp(p - k.xxx, 0.0, 1.0), c.y);
+}
+
+void fragment() {
+	vec3 col = background_color.rgb;
+	float t = TIME * speed;
+
+	for (int i = 0; i < WAVE_COUNT; i++) {
+		float fi = float(i);
+		// Progression 0 (haut de l'écran) -> 1 (bas de l'écran).
+		float fn = fi / float(WAVE_COUNT - 1);
+
+		// Sens de défilement alterné : lignes paires vers la droite,
+		// impaires vers la gauche.
+		float dir = mod(fi, 2.0) < 0.5 ? 1.0 : -1.0;
+		// Fréquence et vitesse de phase différentes par courbe.
+		float freq = 2.5 + fi * 1.15;
+		float phase_speed = (0.6 + fi * 0.17) * dir;
+		// Courbes réparties du haut vers le bas, avec un chevauchement
+		// volontaire (amplitude) pour que les couches se superposent.
+		float base_y = 0.05 + fn * 0.9;
+		float amp = amplitude * (0.5 + 0.5 * sin(fi * 1.3 + 1.0));
+
+		float wave_y = base_y + sin(UV.x * freq * TAU + t * phase_speed + fi * 2.3) * amp;
+
+		// Remplit toute la zone SOUS la sinusoïde (pas juste un trait).
+		float fill = smoothstep(wave_y - 0.004, wave_y + 0.004, UV.y);
+
+		// Teinte qui varie légèrement d'une couche à l'autre, et qui se
+		// fonce/sature vers le bas de l'écran.
+		float hue = mod(base_hue + fn * 0.12 - 0.06, 1.0);
+		float sat = 0.55 + 0.25 * sin(fi * 0.9);
+		float val = 0.35 + 0.5 * fn;
+		vec3 layer_color = hsv2rgb(vec3(hue, sat, val));
+
+		// Mélange par transparence : les couches successives se
+		// superposent au lieu de simplement s'écraser les unes sur les
+		// autres.
+		col = mix(col, layer_color, fill * layer_alpha);
+	}
+
+	COLOR = vec4(col, 1.0);
+}
